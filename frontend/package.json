{
  "name": "uzassets-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --ext .vue,.ts,.tsx --fix",
    "sdk:types": "openapi-typescript http://localhost:8000/api-catalog/openapi.json -o src/sdk/types.generated.ts",
    "sdk:build": "npm run sdk:types",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/qrcode": "^1.5.6",
    "@vueuse/core": "^11.2.0",
    "axios": "^1.7.7",
    "chart.js": "^4.4.5",
    "dompurify": "^3.4.5",
    "pinia": "^2.2.4",
    "qrcode": "^1.5.4",
    "vue": "^3.5.12",
    "vue-chartjs": "^5.3.1",
    "vue-router": "^4.4.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.9",
    "@types/node": "^22.7.9",
    "@vitejs/plugin-vue": "^5.1.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "~5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4",
    "vue-tsc": "^2.1.10"
  }
}
