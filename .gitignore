# ─── Backups (the repo had hundreds of .bak* files; ignore all) ───
# Один глоб покрывает все варианты: .bak, .bakP123.YYYYmmdd, .bakHF, .bakBroken etc.
*.bak*
*-removed.*

# ─── Python ───
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
venv/
.venv/
env/
.env
.env.*
!.env.example

# ─── Node / frontend ───
node_modules/
dist/
.vite/
*.tsbuildinfo
.parcel-cache/

# ─── Secrets — NEVER commit ───
# Firebase service account JSON
backend/firebase-service-account.json
backend/firebase-discovery-report.json

# Cryptographic keys (audit HMAC, Fernet, JWT key pair)
backend/keys/*.key
backend/keys/jwt_private.pem
# jwt_public.pem НЕ коммитим: приватный ключ окружения-специфичен (генерится
# на каждом деплое, в gitignore), а закоммиченный public к нему не парный —
# git reset на VM затирал реальный public репозиторным → signature verify fail
# → выброс на логин после MFA. Каждое окружение держит свою пару локально.
backend/keys/jwt_public.pem

# TLS / certs — никогда не коммитим (включая dev-самоподписанные)
nginx/certs/

# Pack 150 — runtime cert state (backups, certbot, ACME challenges, config)
nginx/certs/backups/
nginx/certs/letsencrypt/
nginx/certs/.well-known/
nginx/certs/config.json

# ─── IDE / OS ───
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo
desktop.ini

# ─── Claude Code local settings (per-developer) ───
.claude/

# ─── Trash directories ───
_trash_*/
_trash/

# ─── Dev probe scripts + ad-hoc SQL (per-session, throwaway) ───
backend/_probe_*.py
backend/_bp_*.sql
backend/_kpi_*.sql
backend/_ui_smoke.py
backend/_ul-*

# ─── Logs / temp ───
*.log
*.tmp
*.temp
.cache/

