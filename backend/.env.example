# =============================================================
# UzAssets Platform — Environment Configuration
# Copy to .env and fill in production values
# =============================================================

# --- PostgreSQL ---
POSTGRES_USER=uza
POSTGRES_PASSWORD=uza_dev_pass_change_me
POSTGRES_DB=uzassets
POSTGRES_PORT=5432

# --- Backend ---
BACKEND_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- JWT (RS256 by default; keys in /app/keys, generated by scripts/generate-keys.sh) ---
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY_PATH=/app/keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=/app/keys/jwt_public.pem
JWT_SECRET=change_me_only_used_when_alg_is_HS256_minimum_32_chars
JWT_ISSUER=uzassets-platform
JWT_AUDIENCE=uzassets-platform
JWT_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=14

# --- Password policy ---
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_LOWER=true
PASSWORD_REQUIRE_UPPER=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SYMBOL=true
PASSWORD_HISTORY_SIZE=5
PASSWORD_MAX_AGE_DAYS=90
BCRYPT_ROUNDS=12

# --- Lockout / sessions ---
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=30
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_HOURS=12

# --- Field encryption ---
FERNET_KEY_PATH=/app/keys/fernet.key

# --- Audit log integrity ---
AUDIT_HMAC_SECRET_PATH=/app/keys/audit_hmac.key
AUDIT_RETENTION_DAYS=1825   # 5 years (state baseline)

# --- Rate limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_API=300/minute
RATE_LIMIT_HEAVY=30/minute

# --- Network / TLS ---
CORS_ORIGINS=http://localhost:5173,http://localhost,http://uzassets006,http://uzassets006:5173,https://uzassets006
TRUSTED_HOSTS=localhost,127.0.0.1,backend,uza-backend,nginx,uzassets006,uzassets006.uz-assets.uz
FORCE_HTTPS=false
HSTS_MAX_AGE_SECONDS=31536000
HSTS_PRELOAD=true
REQUEST_BODY_MAX_BYTES=26214400

# ─── PRODUCTION OVERRIDES (REQUIRED before platform.uz-assets.uz deploy) ──
# Override the dev values above with these when deploying to production.
# After changing CORS_ORIGINS / TRUSTED_HOSTS, restart the backend container.
#
# ENVIRONMENT=production
# FORCE_HTTPS=true
# CORS_ORIGINS=https://platform.uz-assets.uz
# TRUSTED_HOSTS=platform.uz-assets.uz,localhost,127.0.0.1,backend,uza-backend,nginx
#
# Also on the Linux host before docker compose up:
#   chmod 600 backend/keys/*.{key,pem}
#   chmod 644 backend/keys/jwt_public.pem
#
# To strip "Server: nginx" header entirely, switch nginx image to one with
# the headers-more module (e.g. fabiocicerchia/nginx-lua or openresty) and add
# `more_clear_headers Server` in default.conf. Without that module, `server_tokens
# off` strips only the version. Information leak risk: minimal (attacker knows
# it's nginx; version is hidden).

# --- AI engine (vendor-agnostic) ---
AI_API_KEY=
# (опц.) endpoint/версия внешнего LLM-провайдера — если пусто, берётся дефолт из кода
LLM_API_URL=
LLM_API_VERSION=

# --- Knowledge base embeddings (semantic search via Voyage) ---
# Get a key at https://dashboard.voyageai.com (200M tokens free tier).
# Leave blank to keep lexical-only (Postgres FTS) search.
VOYAGE_API_KEY=
# Embedding model + vector size (voyage-3.5 is multilingual: ru/uz/en).
EMBED_MODEL=voyage-3.5
EMBED_DIM=1024

# --- Frontend ---
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000
# When the dev server is reached via a non-localhost name (e.g. http://UZASSETS006:5173),
# set VITE_HMR_HOST to that name so the HMR websocket connects correctly.
VITE_HMR_HOST=localhost
# Comma-separated additional hostnames Vite will accept (mitigates DNS-rebinding).
VITE_EXTRA_HOSTS=

# --- Backup service ---
BACKUP_SCHEDULE=0 */6 * * *           # every 6 hours
BACKUP_RETENTION_DAYS=30
BACKUP_GPG_RECIPIENT=                 # set to a GPG key id to enable encryption
