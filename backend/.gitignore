# --- Security: never commit secrets / certs / backups ---
backend/keys/
nginx/certs/
**/postgres_backups/
*.pem
*.key
*.gpg
*.gpg-bak

# Public JWT verifier — НЕ секрет, нужен в репо для consistent verification
!keys/jwt_public.pem

# Firebase migration artifacts (Part 3)
firebase-service-account.json
firebase-discovery-report.json

# Allow templates and example files only
!.env.example

# --- Local dev artefacts ---
.cache/
tmp/
*.bak
