# UzAssets — production env vars template.
# Скопируй в uzcloud App env-блок для каждого приложения и заполни.
# НИКОГДА не коммить заполненный .env.production в git.
#
# Условные обозначения:
#   <generate>       — сгенерируй криптостойкое значение (openssl rand -hex 32)
#   <secret>         — секрет из 1Password / Vault / личного хранилища
#   <fill>           — нужно указать вручную

# ─────────────────────────────────────────────────────────────────────
# ОБЩИЕ — задаются и в backend-app, и в bot-app, и (часть) в nginx-app
# ─────────────────────────────────────────────────────────────────────
ENVIRONMENT=production
LOG_LEVEL=INFO
LOG_FORMAT=json

# ─────────────────────────────────────────────────────────────────────
# POSTGRES (используется в postgres-app + ссылка из backend/bot)
# ─────────────────────────────────────────────────────────────────────
POSTGRES_USER=uza
POSTGRES_PASSWORD=<generate>
POSTGRES_DB=uzassets

# Опционально (Pack 148 — least-privilege):
APP_DB_USER=uza_app
APP_DB_PASSWORD=<generate>
BACKUP_DB_USER=uza_backup
BACKUP_DB_PASSWORD=<generate>

# ─────────────────────────────────────────────────────────────────────
# BACKEND-APP
# ─────────────────────────────────────────────────────────────────────
# Postgres connection — host = internal DNS-имя postgres-app в uzcloud
DATABASE_URL=postgresql+asyncpg://uza_app:<APP_DB_PASSWORD>@postgres-app:5432/uzassets
DATABASE_URL_SYNC=postgresql+psycopg://uza_app:<APP_DB_PASSWORD>@postgres-app:5432/uzassets
DATABASE_URL_ADMIN=postgresql+psycopg://uza:<POSTGRES_PASSWORD>@postgres-app:5432/uzassets

# JWT — приватный/публичный ключ примонтированы в /app/keys через secret-volume
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY_PATH=/app/keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=/app/keys/jwt_public.pem
JWT_ISSUER=uzassets-platform
JWT_AUDIENCE=uzassets-platform
JWT_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=14

# Password policy
PASSWORD_MIN_LENGTH=12
PASSWORD_HISTORY_SIZE=5
PASSWORD_MAX_AGE_DAYS=90
BCRYPT_ROUNDS=12

# Sessions / lockout
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=30
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_HOURS=12

# Encryption / audit (файлы тоже в /app/keys через secret-volume)
FERNET_KEY_PATH=/app/keys/fernet.key
AUDIT_HMAC_SECRET_PATH=/app/keys/audit_hmac.key
AUDIT_RETENTION_DAYS=1825
MFA_ENCRYPTION_KEY=<generate, base64 32 bytes>

# Rate limit
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_API=300/minute
RATE_LIMIT_HEAVY=30/minute

# Network — критично: добавь domain в TRUSTED_HOSTS, иначе 400 Bad Request
CORS_ORIGINS=https://platform.uz-assets.uz
TRUSTED_HOSTS=platform.uz-assets.uz,backend-app,nginx-app,localhost
FORCE_HTTPS=true
HSTS_MAX_AGE_SECONDS=31536000
REQUEST_BODY_MAX_BYTES=26214400

# AI
ANTHROPIC_API_KEY=<secret>

# Telegram bot
TELEGRAM_BOT_TOKEN=<secret>
TELEGRAM_BOT_USERNAME=UzAssets_bot
BOT_CALLBACK_SECRET=<generate>
PLATFORM_URL=https://platform.uz-assets.uz
TWA_INITDATA_MAX_AGE_SECONDS=86400

PYTHONPATH=/app
RUN_MIGRATIONS=1   # entrypoint runs alembic upgrade head on container start

# ─────────────────────────────────────────────────────────────────────
# NGINX-APP — параметризованные значения для uzcloud
# ─────────────────────────────────────────────────────────────────────
# Внутреннее DNS-имя бэкенда в uzcloud. Если App называется backend-app — оставь.
BACKEND_HOST=backend-app
BACKEND_PORT=8000
