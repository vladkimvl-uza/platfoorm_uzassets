# --- HTTP → HTTPS redirect ---
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    location /__nginx_health__ {
        access_log off;
        return 200 "ok\n";
    }

    # Pack 150: ACME HTTP-01 challenge для Let's Encrypt.
    # certbot (в backend) пишет файлы в shared volume /etc/nginx/certs/.well-known/acme-challenge/.
    # LE-validator стучится по HTTP (NOT HTTPS), поэтому location до redirect.
    location /.well-known/acme-challenge/ {
        alias /etc/nginx/certs/.well-known/acme-challenge/;
        access_log off;
        try_files $uri =404;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# --- HTTPS server ---
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name _;

    # Pack 150: каноничные имена. Если ещё не выпущен production cert —
    # nginx/docker-entrypoint.d/10-bootstrap-certs.sh копирует dev-* в эти
    # имена на первом старте, чтобы nginx запустился. После Let's Encrypt
    # или manual upload — backend перезаписывает эти файлы свежим cert'ом,
    # `docker exec uza-nginx nginx -s reload` подхватывает.
    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;

    # ---- Security headers (defense in depth — backend also sets these) ----
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    add_header X-Frame-Options DENY always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Cross-Origin-Resource-Policy "same-site" always;
    add_header X-Permitted-Cross-Domain-Policies "none" always;
    add_header Permissions-Policy "accelerometer=(), camera=(), geolocation=(), microphone=(self), payment=(), usb=()" always;
    # CSP at the edge — duplicates backend SecurityHeadersMiddleware so misconfigured
    # backend can't accidentally weaken policy. 'unsafe-inline' on style-src is needed
    # for Vue scoped CSS; script-src stays strict. connect-src whitelists external APIs.
    # CSP — connect-src whitelist:
    #   'self'                                 — own API (вкл. ИИ-чат через backend)
    #   https://wttr.in                        — Home page weather widget
    #   https://*.open-meteo.com               — air quality widget
    #   https://cbu.uz                         — currency rates widget
    #   wss://uz-assets040 (or self)           — notifications WebSocket (any-scheme self)
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' wss: https://wttr.in https://*.open-meteo.com https://cbu.uz; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'" always;

    # ---- Connection caps (DoS mitigation) ----
    limit_conn conn_per_ip 50;

    # ---- Health pass-through ----
    location = /healthz { return 200 "ok\n"; }

    # ---- API: rate-limited, proxy to FastAPI ----
    # ---- AI streaming SSE: no buffering, long timeouts ----
    location /api/ai/ {
        proxy_pass         http://${BACKEND_HOST}:${BACKEND_PORT}/ai/;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   Authorization     $http_authorization;

        # SSE-specific
        proxy_buffering         off;
        proxy_cache             off;
        proxy_request_buffering off;
        proxy_read_timeout      300s;
        proxy_send_timeout      300s;
        proxy_set_header   Connection        '';
        chunked_transfer_encoding off;
    }

    # ---- Backend WebSocket endpoints (Pack 11 notifications + Pack 9aJ library sync) ----
    # Matches BEFORE the general /api/ prefix below. Adds Upgrade/Connection
    # headers so FastAPI sees a real WebSocket handshake instead of plain HTTP GET.
    # Covers:
    #   /api/notifications/ws*
    #   /api/broadcasts/ws*  /api/admin-broadcasts/ws*
    #   /api/ws/companies    /api/ws/companies/<id>   (Pack 9aJ)
    location ~ ^/api/(notifications/ws|broadcasts/ws|admin-broadcasts/ws|ws/) {
        rewrite            ^/api/(.*)$ /$1 break;
        proxy_pass         http://${BACKEND_HOST}:${BACKEND_PORT};
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto https;
        proxy_set_header   Authorization     $http_authorization;
        proxy_set_header   Upgrade           $http_upgrade;
        proxy_set_header   Connection        $connection_upgrade;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }

    location /api/ {
        limit_req zone=api_zone burst=200 nodelay;
        proxy_pass         http://${BACKEND_HOST}:${BACKEND_PORT}/;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto https;
        proxy_set_header   X-Request-ID      $http_x_request_id;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    # ---- Auth endpoints: tight rate-limit ----
    location ~ ^/api/auth/(login-mfa|verify-mfa|login|refresh|logout|forgot|reset)$ {
        limit_req zone=auth_zone burst=5 nodelay;
        proxy_pass         http://${BACKEND_HOST}:${BACKEND_PORT}/auth/$1;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto https;
        proxy_set_header   X-Request-ID      $http_x_request_id;
        # No caching of auth responses
        add_header Cache-Control "no-store, no-cache, must-revalidate, private" always;
        add_header Pragma "no-cache" always;
    }

    # ---- Heavy operations (reports, exports) ----
    location ~ ^/api/(reports|export)/ {
        limit_req zone=heavy_zone burst=10 nodelay;
        proxy_pass         http://${BACKEND_HOST}:${BACKEND_PORT}/$1/;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto https;
        proxy_set_header   X-Request-ID      $http_x_request_id;
        proxy_read_timeout 300s;
    }

    # ---- Telegram Web App (Phase C) — separate Vue bundle, base "/twa/".
    #      Built into THIS image via Dockerfile stage `twa-builder`; was
    #      previously a separate `frontend-twa` container behind proxy_pass.
    #      Hashed /twa/assets/* get a long-cache, navigation falls back to
    #      /twa/index.html so Vue Router inside the Mini App handles deep
    #      links. X-Frame-Options is stripped because TG webview must embed. ----
    location /twa/ {
        alias       /usr/share/nginx/html/twa/;
        index       index.html;
        # TG webview embeds the Mini App in an iframe-like surface — DENY would
        # block it. Override to empty (the global add_header is `always`, but
        # `""` removes it from the response). CSP frame-ancestors still applies.
        add_header  X-Frame-Options "" always;
        # Security (audit L-22): локальный add_header выше СБРАСЫВАЕТ наследование
        # server-level заголовков для всего /twa/ → восстанавливаем критичные для
        # HTML Mini App. frame-ancestors НЕ задаём (TG webview должен встраивать),
        # но script-src 'self' + nosniff + HSTS оставляем.
        add_header  X-Content-Type-Options nosniff always;
        add_header  Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
        add_header  Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header  Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' wss: https://wttr.in https://*.open-meteo.com https://cbu.uz; base-uri 'self'; form-action 'self'; object-src 'none'" always;

        # Hashed assets — long-cache, immutable
        location ~* ^/twa/assets/.*\.(js|css|woff2?|ttf|svg|png|jpg|jpeg|webp|ico)$ {
            access_log off;
            expires    1y;
            add_header Cache-Control "public, max-age=31536000, immutable";
            alias      /usr/share/nginx/html/twa/assets/;
            try_files  $uri =404;
        }
        # SPA fallback — every unmatched path returns /twa/index.html
        try_files   $uri $uri/ /twa/index.html;
    }

    # ---- Frontend SPA — static built into this image via multi-stage
    #      Dockerfile (stage `frontend-builder`). Previously proxied to a
    #      separate `frontend` container running `vite preview`; that
    #      container has been removed. ----
    location / {
        root        /usr/share/nginx/html;
        index       index.html;
        # Hashed assets (Vite chunks) — long cache, immutable
        location ~* ^/assets/.*\.(js|css|woff2?|ttf|svg|png|jpg|jpeg|webp|ico)$ {
            access_log off;
            expires    1y;
            add_header Cache-Control "public, max-age=31536000, immutable";
            try_files  $uri =404;
        }
        # index.html / SPA-маршруты — ВСЕГДА ревалидировать, чтобы новый деплой
        # подхватывался без ручной чистки кэша браузера. Хешированные ассеты
        # (выше) остаются immutable. add_header сбрасывает наследование
        # server-level заголовков → security-headers повторяются здесь.
        add_header Cache-Control "no-cache, must-revalidate" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
        add_header X-Frame-Options DENY always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Cross-Origin-Opener-Policy "same-origin" always;
        add_header Cross-Origin-Resource-Policy "same-site" always;
        add_header X-Permitted-Cross-Domain-Policies "none" always;
        add_header Permissions-Policy "accelerometer=(), camera=(), geolocation=(), microphone=(self), payment=(), usb=()" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' wss: https://wttr.in https://*.open-meteo.com https://cbu.uz; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'" always;
        # SPA fallback — every unmatched path returns index.html so Vue Router
        # can handle deep links (/companies/ngmk/workspace etc.)
        try_files   $uri $uri/ /index.html;
    }

    # ---- Block common probes ----
    location ~ /\.(git|env|svn|hg) { deny all; return 403; }
    location ~ \.(asp|aspx|php|php5|php7)$ { deny all; return 403; }
}
