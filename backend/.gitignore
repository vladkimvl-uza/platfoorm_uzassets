# --- Docker ---
postgres_data/
backend_uploads/

# --- Security: never commit secrets / certs / backups ---
backend/keys/
nginx/certs/
**/postgres_backups/
*.pem
*.key
*.gpg
*.gpg-bak

# jwt_public.pem НЕ коммитим — он должен быть парным к окружение-специфичному
# приватному ключу (генерится на каждом деплое). Закоммиченный public к нему
# не парный → git reset затирал реальный → signature verify fail после MFA.

# legacy store migration artifacts (Part 3)
legacy store-service-account.json
legacy store-discovery-report.json

# Allow templates and example files only
!.env.example

# --- Local dev artefacts ---
.cache/
tmp/
*.bak

# Local pip --user installs (pypdf etc., dev-only)
.local/
